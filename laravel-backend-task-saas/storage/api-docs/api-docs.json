{
    "openapi": "3.0.0",
    "info": {
        "title": "Authentication API",
        "description": "API for user authentication and management",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Local server"
        }
    ],
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register User",
                "operationId": "8a56853624e025573120a09a4c75d468",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "default": "leequangkhai621@gmail.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Send verify email successfully."
                    }
                }
            }
        },
        "/api/resend-verify-email": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Resend Verification Email",
                "operationId": "89654d4fcadf8ff74ba8c9774d9ceab9",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "default": "leequangkhai621@gmail.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Verification email resent successfully."
                    },
                    "400": {
                        "description": "This email has not been register."
                    }
                }
            }
        },
        "/api/verify-email": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Verify user email",
                "operationId": "30ad750305b3a9051ad8902b774acaa0",
                "parameters": [
                    {
                        "name": "token",
                        "in": "query",
                        "description": "Verification token",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "email",
                        "in": "query",
                        "description": "User email",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Email verified successfully"
                    },
                    "400": {
                        "description": "Email verification failed"
                    }
                }
            }
        },
        "/api/verify-complete": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Complete User Profile",
                "operationId": "a957ac1f6264ee75d801fcca99161846",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "default": "leequangkhai621@gmail.com"
                                    },
                                    "fullname": {
                                        "type": "string",
                                        "default": "Lê Quang Khải"
                                    },
                                    "password": {
                                        "type": "string",
                                        "default": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profile completed successfully."
                    },
                    "401": {
                        "description": "This email has not been verify."
                    }
                }
            }
        },
        "/api/check-email": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Check Email Existence",
                "operationId": "ff64cff5e21b2a67efda6e48a362b304",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Email already registered."
                    },
                    "404": {
                        "description": "Email not found"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login",
                "operationId": "a3b306d14572d1f4bd6c064b3233e7b8",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "default": "leequangkhai621@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "default": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful authentication"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/api/forgot-password": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Forgot Password",
                "operationId": "7af8817e88ba5874543ff38f188248f1",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "default": "leequangkhai621@gmail.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset link has been sent to your email"
                    },
                    "404": {
                        "description": "User not exits"
                    }
                }
            }
        },
        "/api/resend-forgot-password": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Resend Forgot Password",
                "operationId": "668389037bc65328535a7fb257517e56",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "default": "leequangkhai621@gmail.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Forgot password resent successfully."
                    },
                    "400": {
                        "description": "This email has not been register."
                    }
                }
            }
        },
        "/api/reset-password": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Reset Password",
                "operationId": "00c0aad74830221c6da409a1355ec736",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "userID": {
                                        "type": "string"
                                    },
                                    "token": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string",
                                        "default": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset successfully."
                    },
                    "401": {
                        "description": "Invalid token or email"
                    },
                    "404": {
                        "description": "User not found"
                    }
                }
            }
        },
        "/api/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Get Authenticated User",
                "operationId": "9d9bc556f927575aa492a88c28fe5908",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "example": {
                                                "user": {
                                                    "id": 1,
                                                    "email": "user@example.com"
                                                }
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Could not retrieve user information"
                    },
                    "401": {
                        "description": "Invalid or expired token"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/change-password": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Change User Password",
                "operationId": "540baf9b2324b156be71c57911de6714",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "current_password": {
                                        "type": "string"
                                    },
                                    "new_password": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password changed successfully"
                    },
                    "400": {
                        "description": "Could not change password"
                    },
                    "401": {
                        "description": "Invalid or expired token or incorrect current password"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/refresh": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Refresh JWT Token",
                "operationId": "2c27d311a2876560fcb5a754b556cdc5",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "example": {
                                                "user": {
                                                    "id": 1,
                                                    "email": "user@example.com"
                                                },
                                                "token": "new_jwt_token"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Could not refresh token"
                    },
                    "401": {
                        "description": "Invalid or expired token"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout User",
                "operationId": "fe8f3429cd6979b3b4517e186505f9f9",
                "responses": {
                    "200": {
                        "description": "Logout successfully"
                    },
                    "400": {
                        "description": "Could not logout"
                    },
                    "401": {
                        "description": "Invalid or expired token"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/{provider}/redirect": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Redirect to provider login page",
                "description": "Supported providers: google, github, slack",
                "operationId": "ef28a92994363afab01d183a006c3761",
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "description": "Authentication provider (google|github|slack)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "google",
                                "github",
                                "slack"
                            ]
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to provider login page",
                        "headers": {
                            "Location": {
                                "description": "URL of provider login page",
                                "schema": {
                                    "type": "string",
                                    "example": "https://accounts.google.com/o/oauth2/auth?..."
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/{provider}/callback": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Handle provider callback",
                "description": "After login via Google/GitHub/Slack, backend will create user and return JWT token",
                "operationId": "637bd7b7ce14925bbe174ee226c7b44c",
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "description": "Authentication provider (google|github|slack)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Login success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Login success"
                                        },
                                        "access_token": {
                                            "type": "string",
                                            "example": "eyJ0eXAiOiJKV1QiLCJhbGciOi..."
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "Bearer"
                                        },
                                        "user": {
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "example": "01993906-c75c-72a0-b3fd-db5da877f928"
                                                },
                                                "fullname": {
                                                    "type": "string",
                                                    "example": "Lê Quang Khải"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "leequangkhai621@gmail.com"
                                                },
                                                "avatar_url": {
                                                    "type": "string",
                                                    "example": "https://lh3.googleusercontent.com/..."
                                                },
                                                "provider": {
                                                    "type": "string",
                                                    "example": "google"
                                                },
                                                "provider_id": {
                                                    "type": "string",
                                                    "example": "112233445566778899"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized or invalid provider"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        }
    ],
    "security": [
        {
            "Bearer": []
        }
    ]
}